# Beefree SDK Credentials (REQUIRED)
BEE_CLIENT_ID=YOUR-CLIENT-ID
BEE_CLIENT_SECRET=YOUR-CLIENT-SECRET

# Backend URL (REQUIRED in production, leave empty for local development with Vite proxy)
VITE_BACKEND_URL=

# Backend allowed origin (for CORS), comma separated
ALLOWED_ORIGINS=

# HTML Importer API (OPTIONAL - only needed for "Import HTML" feature)
HTML_IMPORTER_API_KEY=YOUR-HTML-IMPORTER-API-KEY
